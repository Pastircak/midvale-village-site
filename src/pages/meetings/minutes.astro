---
import PageLayout from '../../layouts/PageLayout.astro';
import DocumentList from '../../components/DocumentList.astro';
import { getCollection } from 'astro:content';

const all = await getCollection('meetings');
const items = all
  .filter((m) => !!m.data.minutesUrl)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .map((m) => ({
    title: `${m.data.body === 'council' ? 'Council' : m.data.body} minutes — ${new Date(m.data.date).toLocaleDateString('en-US', { dateStyle: 'medium' })}`,
    href: m.data.minutesUrl!,
    date: m.data.date,
  }));
---

<PageLayout
  title="Minutes"
  description="Approved Council meeting minutes."
  eyebrow="Meetings"
  intro="Approved minutes from past Council meetings."
>
  <DocumentList items={items} emptyMessage="No minutes have been posted to this site yet. Minutes will appear here once approved at the following month's meeting." />

  <p class="text-small text-slate mt-6">
    Need older minutes? <a href="/contact/?topic=records">Submit a public records request</a>.
  </p>
</PageLayout>
