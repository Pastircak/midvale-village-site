---
import PageLayout from '../../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../../utils/date';

const all = await getCollection('meetings');
const sorted = all.sort((a, b) => new Date(a.data.date).getTime() - new Date(b.data.date).getTime());
const now = new Date();
const upcoming = sorted.filter((m) => new Date(m.data.date).getTime() >= now.getTime());
const past = sorted.filter((m) => new Date(m.data.date).getTime() < now.getTime()).reverse();
---

<PageLayout
  title="Meeting Schedule"
  description="Upcoming Village Council meetings."
  eyebrow="Meetings"
  intro="Regular Council meetings are typically the second Wednesday of each month at 7:00 PM in Village Hall."
>
  <section class="mb-10">
    <div class="flex items-baseline justify-between mb-4 flex-wrap gap-2">
      <h2 class="font-serif text-h2 text-ink m-0">Upcoming</h2>
      <a href="/meetings/calendar.ics" class="text-primary font-semibold">Subscribe (iCal) &rarr;</a>
    </div>
    {upcoming.length === 0 ? (
      <p class="text-slate italic">No upcoming meetings posted.</p>
    ) : (
      <ul class="space-y-3">
        {upcoming.map((m) => (
          <li class="bg-white border border-stone rounded-card p-5">
            <p class="text-small font-semibold text-slate uppercase tracking-wider m-0">
              {m.data.body === 'council' ? 'Village Council' : m.data.body}
            </p>
            <h3 class="font-serif text-h3 text-ink m-0 mt-1">
              {formatDate(m.data.date, { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' })}
            </h3>
            <p class="text-body text-slate m-0 mt-1">
              {m.data.time ?? '7:00 PM'} &middot; {m.data.location}
            </p>
            {m.data.note && <p class="text-small text-slate italic mt-2 m-0">{m.data.note}</p>}
            {(m.data.agendaUrl || m.data.minutesUrl) && (
              <p class="mt-3 m-0 flex flex-wrap gap-4">
                {m.data.agendaUrl && <a href={m.data.agendaUrl} target="_blank" rel="noopener noreferrer">Agenda (PDF)</a>}
                {m.data.minutesUrl && <a href={m.data.minutesUrl} target="_blank" rel="noopener noreferrer">Minutes (PDF)</a>}
              </p>
            )}
          </li>
        ))}
      </ul>
    )}
  </section>

  {past.length > 0 && (
    <section>
      <h2 class="font-serif text-h2 text-ink mb-4">Past meetings</h2>
      <ul class="divide-y divide-stone bg-white border border-stone rounded-card">
        {past.slice(0, 12).map((m) => (
          <li class="px-4 py-3 flex flex-wrap items-baseline gap-x-4 gap-y-1">
            <span class="font-semibold text-ink">
              {formatDate(m.data.date, { month: 'short', day: 'numeric', year: 'numeric' })}
            </span>
            <span class="text-small text-slate">{m.data.body === 'council' ? 'Council' : m.data.body}</span>
            <span class="ml-auto flex gap-3 text-small">
              {m.data.agendaUrl && <a href={m.data.agendaUrl} target="_blank" rel="noopener noreferrer">Agenda</a>}
              {m.data.minutesUrl && <a href={m.data.minutesUrl} target="_blank" rel="noopener noreferrer">Minutes</a>}
            </span>
          </li>
        ))}
      </ul>
    </section>
  )}
</PageLayout>
