---
import PageLayout from '../../layouts/PageLayout.astro';
---

<PageLayout
  title="Community Events"
  description="Local events around Midvale, Indian Valley, and Tuscarawas County."
  eyebrow="Events"
  intro="The village doesn't host many of its own events &mdash; but plenty happens nearby."
>
  <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
    <a href="https://www.ivschools.org/" target="_blank" rel="noopener noreferrer" class="group block bg-white border border-stone rounded-card p-6 no-underline transition hover:border-primary hover:shadow-soft">
      <h2 class="font-serif text-h3 text-ink mt-0 group-hover:text-primary">Indian Valley schools</h2>
      <p class="text-body text-slate m-0">Athletic events, plays, concerts, and graduation. Check the district site for the full calendar.</p>
      <p class="text-small text-primary font-semibold mt-3 m-0">ivschools.org &rarr;</p>
    </a>

    <a href="#" class="group block bg-white border border-stone rounded-card p-6 no-underline transition hover:border-primary hover:shadow-soft">
      <h2 class="font-serif text-h3 text-ink mt-0 group-hover:text-primary">Midvale Speedway</h2>
      <p class="text-body text-slate m-0">The summer race schedule. (Link to be added once verified with the speedway.)</p>
    </a>

    <a href="https://traveltusc.com/" target="_blank" rel="noopener noreferrer" class="group block bg-white border border-stone rounded-card p-6 no-underline transition hover:border-primary hover:shadow-soft">
      <h2 class="font-serif text-h3 text-ink mt-0 group-hover:text-primary">Tuscarawas County events</h2>
      <p class="text-body text-slate m-0">County-wide events from the Tuscarawas County Convention &amp; Visitors Bureau.</p>
      <p class="text-small text-primary font-semibold mt-3 m-0">traveltusc.com &rarr;</p>
    </a>
  </div>

  <p class="text-small text-slate mt-10">
    Hosting an event in or near Midvale that should be listed here?
    <a href="/contact/">Let us know</a>.
  </p>
</PageLayout>
