---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { formatDate } from '../../utils/date';

export async function getStaticPaths() {
  const all = await getCollection('news', ({ data }) => !data.draft);
  return all.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props { post: CollectionEntry<'news'>; }

const { post } = Astro.props as Props;
const { Content } = await post.render();
---

<BaseLayout title={post.data.title} description={post.data.excerpt}>
  <article class="container-content py-12 md:py-16">
    <p class="text-small font-semibold text-slate uppercase tracking-wider m-0">
      <a href="/news/" class="text-slate">News</a>
    </p>
    <h1 class="font-serif text-h1 md:text-display text-ink mt-2 mb-3">{post.data.title}</h1>
    <p class="text-body text-slate m-0">
      {formatDate(post.data.date, { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' })}
      {post.data.author && <> &middot; {post.data.author}</>}
    </p>

    <div class="prose-village max-w-prose mt-8">
      <Content />
    </div>

    <p class="mt-12">
      <a href="/news/" class="text-primary font-semibold">&larr; All news</a>
    </p>
  </article>
</BaseLayout>
