---
import PageLayout from '../../layouts/PageLayout.astro';
import ToVerify from '../../components/ToVerify.astro';
---

<PageLayout
  title="Trash & Recycling"
  description="Trash and recycling pickup in the Village of Midvale: provider, schedule, and accepted materials."
  eyebrow="Services"
  intro="Pickup schedule, holiday adjustments, and accepted materials."
>
  <ToVerify note="The trash and recycling provider and schedule for the Village of Midvale need to be confirmed before publishing." />

  <div class="prose-village max-w-prose">
    <h2>Pickup schedule</h2>
    <p>
      The pickup schedule for trash and recycling will appear here once the
      provider is confirmed.
    </p>

    <h2>Holiday adjustments</h2>
    <p>
      Most providers shift collection by one day when a holiday falls on or
      before the regular collection day. Specifics will be posted here once
      confirmed.
    </p>

    <h2>What's accepted</h2>
    <p>
      A list of accepted materials and items requiring special handling
      (electronics, paint, tires, large appliances) will be posted here.
    </p>
  </div>
</PageLayout>
