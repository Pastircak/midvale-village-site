---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found" description="The page you requested could not be found." noIndex>
  <section class="container-content py-20 md:py-28 text-center">
    <p class="text-h4 text-slate font-semibold m-0">404</p>
    <h1 class="font-serif text-h1 md:text-display text-ink mt-2 m-0">We couldn't find that page.</h1>
    <p class="text-body text-slate mt-4 max-w-prose mx-auto">
      The page you requested may have moved, or the link you followed may be out of date.
      Try one of the links below, or use the navigation at the top of the page.
    </p>
    <ul class="mt-8 inline-flex flex-wrap justify-center gap-4">
      <li><a href="/" class="btn-primary">Home</a></li>
      <li><a href="/government/" class="btn-secondary">Government</a></li>
      <li><a href="/services/" class="btn-secondary">Services</a></li>
      <li><a href="/contact/" class="btn-secondary">Contact</a></li>
    </ul>
  </section>
</BaseLayout>
