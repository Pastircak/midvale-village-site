---
import PageLayout from './PageLayout.astro';

export interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
  intro?: string;
}

const { title, description, eyebrow, intro } = Astro.props;
---

<PageLayout title={title} description={description} eyebrow={eyebrow} intro={intro}>
  <article class="prose-village max-w-prose mx-auto">
    <slot />
  </article>
</PageLayout>
