---
// Generic card used in hub pages (Government, Services, Resources)
export interface Props {
  title: string;
  description?: string;
  href: string;
  badge?: string;
}

const { title, description, href, badge } = Astro.props;
---
<a
  href={href}
  class="group block bg-white border border-stone rounded-card p-6 no-underline transition hover:-translate-y-0.5 hover:shadow-lift hover:border-primary"
>
  <div class="flex items-start justify-between gap-3">
    <h3 class="font-serif text-h3 text-ink m-0 group-hover:text-primary">
      {title}
    </h3>
    {badge && (
      <span class="text-small font-semibold text-warning bg-warning/10 px-2 py-0.5 rounded whitespace-nowrap">
        {badge}
      </span>
    )}
  </div>
  {description && (
    <p class="mt-2 text-body text-slate m-0">{description}</p>
  )}
  <p class="mt-4 m-0 text-primary font-semibold text-small">
    Learn more &rarr;
  </p>
</a>
