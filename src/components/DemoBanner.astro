---
// Persistent demo disclosure (spec 5.1) — visible on every page until siteConfig.isOfficial = true
---
<div class="bg-warning text-ink text-small no-print" role="region" aria-label="Site status">
  <div class="container-content py-2 flex flex-wrap items-start gap-x-3 gap-y-1">
    <span aria-hidden="true" class="font-semibold">⚠</span>
    <p class="m-0">
      <strong>Unofficial demonstration site.</strong>
      This is not an official Village of Midvale resource.
      <a href="/unofficial-disclosure/" class="text-ink underline font-semibold ml-1">
        Learn more &rsaquo;
      </a>
    </p>
  </div>
</div>
