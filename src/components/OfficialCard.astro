---
import { formatDateShort } from '../utils/date';

export interface Props {
  name: string;
  title: string;
  term?: string;
  photo?: string | null;
  contactEmail?: string | null;
  verified?: boolean;
  verifiedDate?: Date | string | null;
  notes?: string;
}

const {
  name,
  title,
  term,
  photo,
  contactEmail,
  verified = false,
  verifiedDate,
  notes,
} = Astro.props;

// Build initials for the placeholder if no photo provided
const initials = name.split(/\s+/).filter(Boolean).slice(0, 2).map(p => p[0]?.toUpperCase()).join('');
---

<div class="bg-white border border-stone rounded-card p-6 flex gap-4">
  <div class="flex-shrink-0">
    {photo ? (
      <img src={photo} alt={`Photograph of ${name}`} width="96" height="96" class="w-24 h-24 rounded-full object-cover bg-cream" />
    ) : (
      <div class="w-24 h-24 rounded-full bg-cream border border-stone flex items-center justify-center text-h2 font-serif font-bold text-primary" aria-hidden="true">
        {initials}
      </div>
    )}
  </div>
  <div class="flex-1 min-w-0">
    <h3 class="font-sans text-h4 text-ink m-0">{name}</h3>
    <p class="text-small text-slate m-0">{title}</p>
    {term && <p class="text-small text-slate italic mt-1 m-0">{term}</p>}

    {notes && (
      <p class="text-small text-ink mt-3 mb-0">{notes}</p>
    )}

    <div class="mt-3 flex items-center gap-3 flex-wrap">
      {contactEmail && (
        <a href={`mailto:${contactEmail}`} class="inline-flex items-center gap-1 text-small text-primary font-semibold">
          Contact
        </a>
      )}
      <span class="text-small text-slate">
        {verified
          ? <>Last verified: {verifiedDate ? formatDateShort(verifiedDate) : '—'}</>
          : <span class="text-warning font-semibold">Pending verification</span>
        }
      </span>
    </div>
  </div>
</div>
